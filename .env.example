# --- Supabase (Project Settings → Database / API) ---
# Pooled connection (port 6543) for the app
DATABASE_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=5"
# Direct connection (port 5432) for prisma db push
DIRECT_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"
# Optional: enables instant Realtime updates. Without these the UI polls every 2s.
# The new "publishable" key (sb_publishable_...) works here in place of the legacy anon key.
NEXT_PUBLIC_SUPABASE_URL="https://<ref>.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY=""

# --- LLM (any OpenAI-compatible endpoint) ---
# Pick one: openai | groq | gemini | sarvam | paytm | custom
LLM_PROVIDER="sarvam"
LLM_API_KEY=""
# Empty = preset default (sarvam → sarvam-105b-conversations)
LLM_MODEL=""
# Only needed for paytm / custom (or to override a preset)
LLM_BASE_URL=""

# --- Sarvam AI (voice + Indian languages). Optional: without it, voice notes fall back to typed text. ---
SARVAM_API_KEY=""
